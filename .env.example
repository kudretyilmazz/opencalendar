# OpenCalendar configuration. All values are read at RUNTIME (no rebuild needed to change them).
# Full reference: docs/03-architecture/self-hosting.md

# --- Required ---------------------------------------------------------------
# Local development (npm run services:up). docker-compose.yml sets its own DATABASE_URL.
DATABASE_URL=postgres://opencal:opencal@localhost:5433/opencal
# docker-compose.yml only: password of its Postgres; URL-safe characters only (openssl rand -hex 24)
POSTGRES_PASSWORD=
APP_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# openssl rand -base64 32  (must decode to exactly 32 bytes)
ENCRYPTION_KEY=

# --- Email (Mailpit in development) -------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenCalendar <no-reply@localhost>

# --- Instance -----------------------------------------------------------------
# open | invite_only | disabled  (the first user always becomes the admin)
# invite_only: new people join only when a team invites their address, by signing in with an email link
# Default only: an admin can override it under Administration → Platform (ADR-0007).
SIGNUP_MODE=open
# external (run `npm run worker`) | inline (worker runs inside the web process)
WORKER_MODE=inline
MIGRATE_ON_START=true
LOG_LEVEL=info

# --- Optional sign-in providers (hidden unless both values are set) -------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Optional video conferencing --------------------------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
JITSI_BASE_URL=https://meet.jit.si

# --- Integrations -------------------------------------------------------------
# Allow CalDAV servers / ICS feeds on private networks (e.g. a LAN Nextcloud, or the local
# Radicale from docker-compose.dev.yml at http://localhost:5232, user host / hostpass).
ALLOW_PRIVATE_NETWORK_INTEGRATIONS=false
# Allow webhook targets on private/loopback addresses and plain http (e.g. a LAN n8n).
WEBHOOK_ALLOW_PRIVATE=false

# Anti-abuse (ADM-007): "altcha" = self-hosted proof-of-work check on public booking forms.
CAPTCHA=off

# --- Observability ------------------------------------------------------------
# Enables GET /api/metrics (Prometheus); send "Authorization: Bearer <token>". 16+ characters.
METRICS_TOKEN=

# --- Embeds -------------------------------------------------------------------
# Origins allowed to embed booking pages (CSP frame-ancestors), space-separated, e.g.
# "https://example.com https://*.example.org". Empty = any site; "none" = embedding disabled.
EMBED_ALLOWED_ORIGINS=

# --- License ------------------------------------------------------------------
# AGPL-3.0: every page links to the source code. If you run a modified version, point this at
# your fork. Empty = the upstream repository.
SOURCE_URL=

# --- Calendars ----------------------------------------------------------------
# How often CalDAV calendars and ICS feeds are re-read, in seconds (default 300).
CALENDAR_POLL_SECONDS=
